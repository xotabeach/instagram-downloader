TELEGRAM_BOT_TOKEN=123456:ABC
# Cookies из браузера на macOS лучше не включать (Keychain-попапы).
# INSTAGRAM_COOKIES_FROM_BROWSER=chrome
# Legacy single file (при старте мигрирует в пул, если слот 1 пуст):
INSTAGRAM_COOKIES_FILE=/Users/nikita/Documents/instagram-downloader/instagram_cookies.txt
# Пул cookies для ротации (общий на всех юзеров бота):
# INSTAGRAM_COOKIES_DIR=/opt/instagram-downloader/instagram_cookies
INSTAGRAM_COOKIE_SLOTS=5
# Лимит Instagram на весь бот (не на юзера):
INSTAGRAM_MAX_DOWNLOADS_PER_HOUR=20
INSTAGRAM_MIN_INTERVAL_SECONDS=25
# Слот после login/checkpoint не трогаем N секунд:
INSTAGRAM_COOKIE_DEAD_COOLDOWN_SECONDS=21600
# Для age-restricted YouTube — отдельный cookies.txt с youtube.com:
# YOUTUBE_COOKIES_FILE=/Users/nikita/Documents/instagram-downloader/youtube_cookies.txt
TELEGRAM_AUTH_QUESTION='Как зовут автора бота?'
TELEGRAM_AUTH_ANSWER=xotabeach
TELEGRAM_SEND_PREVIEW=true
# Вторая копия файлом: удобно, но грузит то же видео в Telegram ещё раз.
TELEGRAM_SEND_DOCUMENT=false
# true = фото как превью в чате (Telegram сожмёт); false = файлом без сжатия
TELEGRAM_PHOTO_PREVIEW=true
